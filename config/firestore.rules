rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated security operations team can read/write incident logs
    match /sentinel_incidents/{incidentId} {
      allow read: if request.auth != null || request.auth.token.role == 'secops_admin';
      allow write: if request.auth != null && request.auth.token.role in ['backend_service', 'secops_admin'];
    }

    match /sentinel_traffic_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /sentinel_mitigations/{actionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'secops_admin';
    }
  }
}
