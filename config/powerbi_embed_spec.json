  "daxMeasures": [
    {
      "name": "TotalIncidents",
      "expression": "COUNTROWS('SentinelIncidents')"
    },
    {
      "name": "PortScanRate",
      "expression": "DIVIDE(CALCULATE(COUNTROWS('SentinelIncidents'), 'SentinelIncidents'[AttackType] = \"Port Scanning\"), [TotalIncidents], 0)"
    },
    {
      "name": "BruteForceRate",
      "expression": "DIVIDE(CALCULATE(COUNTROWS('SentinelIncidents'), 'SentinelIncidents'[AttackType] = \"Brute Force\"), [TotalIncidents], 0)"
    },
    {
      "name": "AverageMTTD_Seconds",
      "expression": "AVERAGE('SentinelIncidents'[DetectionDurationMs]) / 1000"
    }
  ]
}
